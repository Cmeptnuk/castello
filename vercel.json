{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/catalog", "destination": "/catalog.html" },
    { "source": "/how", "destination": "/how.html" },
    { "source": "/payment", "destination": "/payment.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/discord", "destination": "/discord.html" },
    { "source": "/((?!assets/|fonts/).*)", "destination": "/" }
  ]
}
